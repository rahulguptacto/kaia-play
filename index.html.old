CI.forEach(function(id){var el=document.createElement('div');el.className='cs idle';el.innerHTML=CSV[id](CZ[id]);el.style.left=cp[id].x+'%';el.style.bottom=cp[id].y+'%';el.style.transform='translate(-50%,0)';el.addEventListener('pointerdown',function(e){e.stopPropagation();if(A&&!bu[id])trg(id)});stage.appendChild(el);cel[id]=el});

/* PLAY ROUTINE */
function play(cid,steps){if(ct[cid])ct[cid].forEach(clearTimeout);ct[cid]=[];var el=cel[cid];el.classList.remove('idle');el.classList.add('active');var elapsed=0;steps.forEach(function(step){var tid=setTimeout(function(){try{Object.assign(el.style,step.s)}catch(e){}if(step.x)try{step.x()}catch(e){}if(step.sp)say(step.sp,step.pp,step.rr);var ov=el.querySelector('.pov');if(step.ov){if(!ov){ov=document.createElement('div');ov.className='pov';ov.style.cssText='position:absolute;top:30%;left:50%;transform:translate(-50%,-50%);font-size:70px;z-index:40;animation:ob .8s ease-in-out infinite alternate';el.appendChild(ov)}ov.textContent=step.ov}else if(ov)ov.remove();if(step.sk){var rg=document.createElement('div');rg.style.cssText='position:absolute;inset:0;pointer-events:none;z-index:35';var em=['✨','⭐','🌟','💫'];for(var i=0;i<12;i++){var sp2=document.createElement('div');var a=(i/12)*Math.PI*2,d=65+Math.random()*20;sp2.style.cssText='position:absolute;left:calc(50% + '+Math.cos(a)*d+'px);top:calc(45% + '+Math.sin(a)*d+'px);font-size:'+(16+Math.random()*10)+'px;animation:sf 1s ease-out '+i*.04+'s both;transform:translate(-50%,-50%)';sp2.textContent=em[i%4];rg.appendChild(sp2)}el.appendChild(rg);setTimeout(function(){rg.remove()},1200)}},elapsed);ct[cid].push(tid);elapsed+=step.d});var eid=setTimeout(function(){el.style.transform='translate(-50%,0)';el.style.opacity='1';el.classList.remove('active');el.classList.add('idle');var ov=el.querySelector('.pov');if(ov)ov.remove();bu[cid]=false},elapsed);ct[cid].push(eid);return elapsed}

function trg(cid){bu[cid]=true;S.cv(cid);play(cid,pk(ACT).g())}

/* BURST */
var BE=['⭐','✨','💖','🌟','🎉','💫','🌈','🦋','🎀','💕','🌸','🎊'];
function burst(x,y){var c=document.createElement('div');c.style.cssText='position:absolute;left:'+x+'px;top:'+y+'px;pointer-events:none;z-index:200';var f=document.createElement('div');f.style.cssText='position:absolute;left:-40px;top:-40px;width:80px;height:80px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,100,.9),rgba(255,100,200,.5) 40%,transparent 70%);animation:fo .6s ease-out forwards';c.appendChild(f);for(var i=0;i<10;i++){var em=document.createElement('div');var a=(i/10)*Math.PI*2+(Math.random()-.5)*.3,d=50+Math.random()*80;em.style.cssText='position:absolute;font-size:'+(22+Math.random()*20)+'px;left:-12px;top:-12px;animation:bo .8s ease-out '+Math.random()*.06+'s forwards;opacity:0';em.style.setProperty('--bx',Math.cos(a)*d+'px');em.style.setProperty('--by',Math.sin(a)*d+'px');em.textContent=pk(BE);c.appendChild(em)}stage.appendChild(c);setTimeout(function(){c.remove()},900)}

/* STAGE TAP */
stage.addEventListener('pointerdown',function(e){var rect=stage.getBoundingClientRect(),cx=e.clientX-rect.left,cy=e.clientY-rect.top;burst(cx,cy);if(A)S.tap(cx/rect.width);st++;if(lm==='counting'){cc++;var emoji=pk(CE);var el=document.createElement('div');el.style.cssText='position:absolute;left:'+(cx-30)+'px;top:'+(cy-30)+'px;font-size:60px;pointer-events:none;z-index:100;animation:stp .5s ease-out';el.textContent=emoji;stage.appendChild(el);setTimeout(function(){el.remove()},1500);if(cc<=10){var w=['','One!','Two!','Three!','Four!','Five!','Six!','Seven!','Eight!','Nine!','Ten!'];say(w[cc],1.8,1.1);if(cc===10)setTimeout(function(){say("Yay! You counted to ten!",1.8);S.cel();cc=0},1500)}else{cc=1;say("One!",1.8)}return}if(st%5===0){if(A)S.cel();say(pk(["Yay Kaia!","Amazing!","Superstar!","Wonderful!"]),1.8);addStar()}});
function addStar(){var s=document.createElement('span');s.textContent='⭐';s.style.cssText='font-size:18px;animation:stp .4s ease-out';ste.appendChild(s);if(ste.children.length>20)ste.firstChild.remove()}

/* SCENE */
var fd=[];
function setSc(i){cs=i;stage.style.background=SC[i].bg;updF();document.querySelectorAll('.sb').forEach(function(b,j){b.classList.toggle('on',j===i)})}
function updF(){fle.innerHTML='';fd=SC[cs].f.map(function(emoji){var el=document.createElement('div');el.style.cssText='position:absolute;pointer-events:none;opacity:.55;filter:drop-shadow(0 2px 3px rgba(0,0,0,.15))';el.textContent=emoji;var d={el:el,x:Math.random()*85+5,y:Math.random()*30+5,ph:Math.random()*Math.PI*2,sp:.2+Math.random()*.4,sz:26+Math.random()*18};el.style.fontSize=d.sz+'px';el.style.left=d.x+'%';el.style.top=d.y+'%';fle.appendChild(el);return d})}
setInterval(function(){fd.forEach(function(f){f.ph+=.02*f.sp;f.x+=Math.sin(f.ph)*.1;f.el.style.left=f.x+'%';f.el.style.top=(f.y+Math.sin(f.ph)*2)+'%'})},50);

var CB={luna:{a:3,b:18,c:3,d:18},benny:{a:20,b:38,c:3,d:18},sunny:{a:40,b:58,c:6,d:22},pippa:{a:60,b:78,c:3,d:18},rosie:{a:78,b:95,c:3,d:18}};
setInterval(function(){CI.forEach(function(id){if(bu[id])return;var b=CB[id],p=cp[id];p.x=Math.max(b.a,Math.min(b.b,p.x+(Math.random()-.5)*5));p.y=Math.max(b.c,Math.min(b.d,p.y+(Math.random()-.5)*5));cel[id].style.left=p.x+'%';cel[id].style.bottom=p.y+'%'})},3000);

setInterval(function(){if(lm||!A)return;var av=CI.filter(function(c){return!bu[c]});if(!av.length)return;var cid=pk(av);bu[cid]=true;play(cid,autoR(pk(AP)))},10000);

setInterval(function(){if(!lm)setSc((cs+1)%SC.length)},30000);

/* BAR */
SC.forEach(function(sc,i){var b=document.createElement('button');b.className='sb'+(i===0?' on':'');b.textContent=sc.e;b.addEventListener('pointerdown',function(e){e.stopPropagation();if(A)S.tap(.5);clrL();setSc(i)});bar.appendChild(b)});
bar.appendChild(Object.assign(document.createElement('div'),{className:'dv'}));
ACT.forEach(function(act){var b=document.createElement('button');b.className='ab';b.textContent=act.e;b.addEventListener('pointerdown',function(e){e.stopPropagation();if(!A)return;clrL();b.classList.add('on');setTimeout(function(){b.classList.remove('on')},500);CI.forEach(function(cid,j){setTimeout(function(){bu[cid]=true;play(cid,act.g())},j*200)})});bar.appendChild(b)});
bar.appendChild(Object.assign(document.createElement('div'),{className:'dv'}));
[{e:'🎨',fn:stColor},{e:'🐮',fn:stAnimal},{e:'🔢',fn:stCount}].forEach(function(lb){var b=document.createElement('button');b.className='lb';b.textContent=lb.e;b.addEventListener('pointerdown',function(e){e.stopPropagation();if(!A)return;document.querySelectorAll('.lb').forEach(function(x){x.classList.remove('on')});b.classList.add('on');lb.fn()});bar.appendChild(b)});
bar.appendChild(Object.assign(document.createElement('div'),{className:'dv'}));
var mN=document.createElement('button');mN.className='mb';mN.textContent='🎵';
var mR=document.createElement('button');mR.className='mb';mR.textContent='🐰';
mN.addEventListener('pointerdown',function(e){e.stopPropagation();if(!A)return;var t=Tone.getTransport();if(t.state==='started'){t.stop();t.cancel();mN.classList.remove('on');mR.classList.remove('on');djb.classList.remove('show');return}var on=toggleMusic('normal');mN.classList.toggle('on',on);mR.classList.remove('on');djb.classList.remove('show');if(on)say("Music time!",1.8)});
mR.addEventListener('pointerdown',function(e){e.stopPropagation();if(!A)return;var t=Tone.getTransport();if(t.state==='started'){t.stop();t.cancel();mR.classList.remove('on');mN.classList.remove('on');djb.classList.remove('show');return}var on=toggleMusic('reggaeton');mR.classList.toggle('on',on);mN.classList.remove('on');djb.classList.toggle('show',on);if(on)say("DJ Bunny in the house!",1.7)});
bar.appendChild(mN);bar.appendChild(mR);

setSc(0);
</script>
</body>
</html>
