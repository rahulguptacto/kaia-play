<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Kaia's World">
<title>Kaia's World</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-touch-callout:none;user-select:none;-webkit-user-select:none}
html,body{width:100%;height:100%;overflow:hidden;font-family:-apple-system,system-ui,sans-serif;touch-action:manipulation}
#app{width:100%;height:100%;display:flex;flex-direction:column}
#stage{flex:1;position:relative;overflow:hidden;cursor:pointer}
#splash{position:fixed;inset:0;z-index:9999;background:linear-gradient(135deg,#FFB6C1,#E6B0FA,#87CEEB);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;cursor:pointer}
#splash.hidden{display:none}
#splash .big-emoji{font-size:120px;animation:sb 1s ease-in-out infinite alternate}
#splash .tap-text{font-size:28px;font-weight:800;color:white;text-shadow:0 2px 8px rgba(0,0,0,.2);animation:sp 1.5s ease-in-out infinite}
.cs{position:absolute;display:flex;flex-direction:column;align-items:center;cursor:pointer;padding:8px;transition:left 3s ease-in-out,bottom 3s ease-in-out,transform .2s ease-out,opacity .15s ease-out;filter:drop-shadow(0 4px 8px rgba(0,0,0,.3))}
.cs.active{filter:drop-shadow(0 0 20px rgba(255,255,100,.7))}
.cs.idle{animation:idf 2.5s ease-in-out infinite}
#bar{display:flex;align-items:center;justify-content:center;gap:6px;padding:8px 6px 10px;background:linear-gradient(180deg,rgba(0,0,0,.15),rgba(0,0,0,.35));backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-top:1px solid rgba(255,255,255,.1);z-index:100;padding-bottom:max(10px,env(safe-area-inset-bottom));overflow-x:auto;-webkit-overflow-scrolling:touch}
#bar button{border:none;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;flex-shrink:0}
.sb{width:38px;height:38px;font-size:17px;border:2px solid rgba(255,255,255,.15)!important;background:rgba(255,255,255,.06)}
.sb.on{border-color:white!important;background:rgba(255,255,255,.3)}
.ab{width:56px;height:56px;font-size:26px;border:3px solid rgba(255,255,255,.2)!important;background:rgba(255,255,255,.1)}
.ab.on{border-color:white!important;background:linear-gradient(135deg,#FFD93D,#FF6B9D);transform:scale(1.15);box-shadow:0 0 25px rgba(255,107,157,.5)}
.lb{width:56px;height:56px;font-size:26px;border:3px solid rgba(100,200,255,.3)!important;background:rgba(100,200,255,.1)}
.lb.on{border-color:#4CC9F0!important;background:linear-gradient(135deg,#4CC9F0,#A855F7);transform:scale(1.15)}
.mb{width:44px;height:44px;font-size:20px;border:3px solid rgba(255,255,255,.2)!important;background:rgba(255,255,255,.08)}
.mb.on{border-color:#FFD700!important;background:linear-gradient(135deg,#FFD93D,#FB5607);box-shadow:0 0 20px rgba(255,217,61,.5);animation:mp .6s ease-in-out infinite alternate}
.dv{width:1px;height:36px;background:rgba(255,255,255,.2);margin:0 2px;flex-shrink:0}
#bub{position:absolute;top:4%;left:50%;transform:translateX(-50%);z-index:150;background:white;border-radius:24px;padding:12px 24px;box-shadow:0 6px 30px rgba(0,0,0,.2);text-align:center;display:none;animation:pb .3s cubic-bezier(.34,1.56,.64,1)}
#bub.show{display:block}
#bub::after{content:'';position:absolute;bottom:-10px;left:50%;margin-left:-10px;border:10px solid transparent;border-top-color:white}
.cf{position:absolute;inset:0;pointer-events:none;z-index:50;opacity:0;transition:opacity .3s}
.cf.show{opacity:.3}
.lt{position:absolute;z-index:60;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;animation:tp 1s ease-in-out infinite alternate;box-shadow:0 4px 20px rgba(0,0,0,.3)}
.lp{position:absolute;top:8%;left:50%;transform:translateX(-50%);z-index:160;background:rgba(0,0,0,.6);border-radius:20px;padding:10px 24px;display:none;animation:pb .3s cubic-bezier(.34,1.56,.64,1)}
.lp.show{display:flex;align-items:center;gap:10px}
.lp .pe{font-size:40px}
.lp .pc{width:40px;height:40px;border-radius:50%;border:3px solid white}
#sc{position:absolute;top:10px;right:10px;display:flex;gap:1px;flex-wrap:wrap;max-width:120px;z-index:100}
.dj{position:absolute;top:10px;left:10px;z-index:90;display:none;animation:djb .5s ease-in-out infinite alternate}
.dj.show{display:block}
@keyframes idf{0%,100%{transform:translate(-50%,0) translateY(0)}50%{transform:translate(-50%,0) translateY(-6px)}}
@keyframes ob{0%{transform:translate(-50%,-50%) scale(1)}100%{transform:translate(-50%,-50%) scale(1.15) rotate(5deg)}}
@keyframes sf{0%{opacity:0;transform:translate(-50%,-50%) scale(0)}30%{opacity:1;transform:translate(-50%,-50%) scale(1.3)}100%{opacity:0;transform:translate(-50%,-50%) scale(.5) translateY(-20px)}}
@keyframes fo{0%{opacity:1;transform:scale(.3)}100%{opacity:0;transform:scale(3)}}
@keyframes bo{0%{opacity:1;transform:translate(0,0) scale(.3) rotate(0)}40%{opacity:1}100%{opacity:0;transform:translate(var(--bx),var(--by)) scale(1.2) rotate(220deg)}}
@keyframes mp{from{transform:scale(1)}to{transform:scale(1.15)}}
@keyframes stp{0%{transform:scale(0) rotate(0)}60%{transform:scale(1.4) rotate(180deg)}100%{transform:scale(1) rotate(360deg)}}
@keyframes pb{0%{transform:translateX(-50%) scale(0)}60%{transform:translateX(-50%) scale(1.1)}100%{transform:translateX(-50%) scale(1)}}
@keyframes db{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
@keyframes tp{0%{transform:scale(1)}100%{transform:scale(1.1)}}
@keyframes djb{0%{transform:translateY(0) rotate(-3deg)}100%{transform:translateY(-5px) rotate(3deg)}}
@keyframes sb{0%{transform:scale(1) rotate(-5deg)}100%{transform:scale(1.15) rotate(5deg)}}
@keyframes sp{0%,100%{opacity:1}50%{opacity:.6}}
</style>
</head>
<body>
<div id="app">
<div id="splash"><div class="big-emoji">🌸</div><div class="tap-text">Tap to Play!</div><div class="big-emoji" style="font-size:60px;animation-delay:.3s">🎵 ✨ 🐱</div></div>
<div id="stage"></div>
<div id="bar"></div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
<script>
/* ═══════════════════════════════════════════════════
   100% SYNCHRONOUS splash handler.
   Zero await. Zero .then(). Zero callbacks.
   Everything happens in one synchronous block.
   ═══════════════════════════════════════════════════ */
var A=false,V=false,sv=null;
var xylo,bell,bounce,pluck,spk,whoosh,kick,hat,bass,pad;

function lv(){
  try{
    var v=speechSynthesis.getVoices();
    if(!v.length)return;
    /* Prefer Samantha (iOS default, clear female voice) */
    sv=v.find(function(x){return x.name==='Samantha'})
      ||v.find(function(x){return x.name==='Karen'})
      ||v.find(function(x){return x.name.indexOf('Google US English')>=0})
      ||v.find(function(x){return x.lang==='en-US'&&x.localService})
      ||v.find(function(x){return x.lang.indexOf('en')===0})
      ||v[0];
    V=true; /* voices loaded — speech is available */
  }catch(e){}
}
lv();
try{speechSynthesis.onvoiceschanged=lv}catch(e){}
setTimeout(lv,100);setTimeout(lv,250);setTimeout(lv,500);setTimeout(lv,1000);setTimeout(lv,2000);setTimeout(lv,4000);

/* iOS speech keepalive — iOS kills speechSynthesis after ~15s idle.
   Periodically poke it with an empty utterance to keep it alive. */
setInterval(function(){
  try{
    if(!V)lv(); /* keep trying to load voices */
    speechSynthesis.cancel();
    var k=new SpeechSynthesisUtterance('');
    k.volume=0;
    speechSynthesis.speak(k);
  }catch(e){}
},10000);

var spl=document.getElementById('splash'),done=false;

function onTap(e){
  e.preventDefault();
  if(done)return;
  done=true;

  // ── ALL SYNCHRONOUS. No await, no .then, no callbacks ──

  // 1) Voice unlock — MUST happen in user gesture for iOS
  try{
    lv();
    /* Mark voice as available if speechSynthesis exists at all */
    if(window.speechSynthesis)V=true;
    /* iOS requires cancel() before first speak in a gesture */
    speechSynthesis.cancel();
    var u=new SpeechSynthesisUtterance('Hello Kaia!');
    u.pitch=1.7;u.rate=1.05;u.volume=1;
    if(sv)u.voice=sv;
    u.onend=function(){showBub(false)};
    u.onerror=function(){showBub(false)};
    speechSynthesis.speak(u);
    showBub(true);
    /* iOS: retry voice loading after gesture unlock */
    setTimeout(lv,200);
    setTimeout(lv,1000);
  }catch(e){if(window.speechSynthesis)V=true}

  // 2) Tone unlock — just call start(), don't wait for promise
  try{Tone.start()}catch(e){}

  // 3) Create synths SYNCHRONOUSLY — right here, right now
  try{
    xylo=new Tone.Synth({oscillator:{type:'sine'},envelope:{attack:.001,decay:.35,sustain:0,release:.25},volume:-3}).toDestination();
    bell=new Tone.PolySynth(Tone.Synth,{oscillator:{type:'triangle'},envelope:{attack:.008,decay:.5,sustain:.08,release:.7},volume:-5}).toDestination();
    bounce=new Tone.MembraneSynth({pitchDecay:.06,octaves:5,volume:-8}).toDestination();
    pluck=new Tone.PluckSynth({volume:-4}).toDestination();
    spk=new Tone.Synth({oscillator:{type:'sine'},envelope:{attack:.001,decay:.15,sustain:0,release:.1},volume:-6}).toDestination();
    whoosh=new Tone.NoiseSynth({noise:{type:'pink'},envelope:{attack:.05,decay:.25,sustain:0,release:.1},volume:-14}).toDestination();
    kick=new Tone.MembraneSynth({pitchDecay:.05,octaves:6,volume:-10}).toDestination();
    hat=new Tone.NoiseSynth({noise:{type:'white'},envelope:{attack:.001,decay:.04,sustain:0,release:.02},volume:-18}).toDestination();
    bass=new Tone.Synth({oscillator:{type:'triangle'},envelope:{attack:.05,decay:.2,sustain:.3,release:.15},volume:-12}).toDestination();
    pad=new Tone.PolySynth(Tone.Synth,{oscillator:{type:'sine'},envelope:{attack:.3,decay:.8,sustain:.4,release:1},volume:-20}).toDestination();
    A=true;
  }catch(e){
    // If synths fail, try again after a moment
    setTimeout(function(){
      try{
        xylo=new Tone.Synth({oscillator:{type:'sine'},envelope:{attack:.001,decay:.35,sustain:0,release:.25},volume:-3}).toDestination();
        bell=new Tone.PolySynth(Tone.Synth,{oscillator:{type:'triangle'},envelope:{attack:.008,decay:.5,sustain:.08,release:.7},volume:-5}).toDestination();
        bounce=new Tone.MembraneSynth({pitchDecay:.06,octaves:5,volume:-8}).toDestination();
        pluck=new Tone.PluckSynth({volume:-4}).toDestination();
        spk=new Tone.Synth({oscillator:{type:'sine'},envelope:{attack:.001,decay:.15,sustain:0,release:.1},volume:-6}).toDestination();
        whoosh=new Tone.NoiseSynth({noise:{type:'pink'},envelope:{attack:.05,decay:.25,sustain:0,release:.1},volume:-14}).toDestination();
        kick=new Tone.MembraneSynth({pitchDecay:.05,octaves:6,volume:-10}).toDestination();
        hat=new Tone.NoiseSynth({noise:{type:'white'},envelope:{attack:.001,decay:.04,sustain:0,release:.02},volume:-18}).toDestination();
        bass=new Tone.Synth({oscillator:{type:'triangle'},envelope:{attack:.05,decay:.2,sustain:.3,release:.15},volume:-12}).toDestination();
        pad=new Tone.PolySynth(Tone.Synth,{oscillator:{type:'sine'},envelope:{attack:.3,decay:.8,sustain:.4,release:1},volume:-20}).toDestination();
        A=true;
      }catch(e2){}
    },500);
  }

  // 4) Hide splash — synchronous, immediate
  spl.classList.add('hidden');
}

spl.addEventListener('touchstart',onTap,{passive:false});
spl.addEventListener('click',onTap);

/* ═══════════════════════════════════════════════════ */
function say(t,p,r){
  if(!V||!window.speechSynthesis)return;
  try{
    lv();
    speechSynthesis.cancel();
    /* iOS needs a small delay after cancel() before speak() works */
    setTimeout(function(){
      try{
        var u=new SpeechSynthesisUtterance(t);
        u.pitch=Math.min(Math.max(p||1.7,.1),2);
        u.rate=Math.min(Math.max(r||1.05,.1),2);
        u.volume=1;
        if(sv)u.voice=sv;
        u.onstart=function(){showBub(true)};
        u.onend=function(){showBub(false)};
        u.onerror=function(){
          showBub(false);
          /* iOS fallback: retry once after a longer delay */
          setTimeout(function(){
            try{
              speechSynthesis.cancel();
              var u2=new SpeechSynthesisUtterance(t);
              u2.pitch=Math.min(Math.max(p||1.7,.1),2);
              u2.rate=Math.min(Math.max(r||1.05,.1),2);
              u2.volume=1;
              if(sv)u2.voice=sv;
              u2.onstart=function(){showBub(true)};
              u2.onend=function(){showBub(false)};
              u2.onerror=function(){showBub(false)};
              speechSynthesis.speak(u2);
            }catch(e2){showBub(false)}
          },250);
        };
        speechSynthesis.speak(u);
      }catch(e){showBub(false)}
    },120);
  }catch(e){showBub(false)}
}

var S={
tap:function(x){if(!A)return;try{var s=['C4','D4','E4','G4','A4','C5','D5','E5','G5','A5','C6'];xylo.triggerAttackRelease(s[Math.min(Math.floor(x*s.length),s.length-1)],'8n')}catch(e){}},
ph:function(){if(!A)return;try{var n=Tone.now();['G5','E5','C5','G4'].forEach(function(x,i){spk.triggerAttackRelease(x,.1,n+i*.08)});whoosh.triggerAttackRelease('8n',n+.1)}catch(e){}},
pr:function(){if(!A)return;try{var n=Tone.now();bounce.triggerAttackRelease('C2','4n',n);['C4','E4','G4','C5','E5','G5','C6'].forEach(function(x,i){bell.triggerAttackRelease([x],.1,n+i*.06)})}catch(e){}},
db:function(){if(!A)return;try{bounce.triggerAttackRelease('C2','16n');xylo.triggerAttackRelease(['C5','D5','E5','G5','A5'][Math.floor(Math.random()*5)],'16n',Tone.now()+.05)}catch(e){}},
ju:function(){if(!A)return;try{var n=Tone.now();['C4','E4','G4','C5','E5'].forEach(function(x,i){spk.triggerAttackRelease(x,.08,n+i*.04)});whoosh.triggerAttackRelease('16n',n)}catch(e){}},
jl:function(){if(!A)return;try{bounce.triggerAttackRelease('C2','8n');setTimeout(function(){bell.triggerAttackRelease(['C4','E4','G4'],.15)},100)}catch(e){}},
ss:function(){if(!A)return;try{var n=Tone.now();whoosh.triggerAttackRelease('4n',n);['C5','D5','E5','F5','G5','A5','B5','C6'].forEach(function(x,i){spk.triggerAttackRelease(x,.06,n+i*.08)})}catch(e){}},
wg:function(){if(!A)return;try{var n=Tone.now();['E5','G5','E5','G5','E5','G5','C6'].forEach(function(x,i){xylo.triggerAttackRelease(x,'32n',n+i*.07)})}catch(e){}},
cel:function(){if(!A)return;try{var n=Tone.now();bounce.triggerAttackRelease('C2','4n',n);['C4','E4','G4','C5'].forEach(function(x,i){bell.triggerAttackRelease([x],.15,n+i*.1)});setTimeout(function(){['E5','G5','C6','E6'].forEach(function(x,i){spk.triggerAttackRelease(x,.1,Tone.now()+i*.06)})},400)}catch(e){}},
ok:function(){if(!A)return;try{var n=Tone.now();['C5','E5','G5','C6'].forEach(function(x,i){bell.triggerAttackRelease([x],.12,n+i*.08)})}catch(e){}},
no:function(){if(!A)return;try{bounce.triggerAttackRelease('E2','8n')}catch(e){}},
cv:function(id){if(!A)return;try{var n=Tone.now();var p={luna:function(){['E5','G5','B5','E6'].forEach(function(x,i){bell.triggerAttackRelease([x],.15,n+i*.09)})},benny:function(){bounce.triggerAttackRelease('C2','8n',n);setTimeout(function(){bell.triggerAttackRelease(['C4','E4','G4'],.2)},150)},sunny:function(){['C5','E5','G5','C6','E6'].forEach(function(x,i){spk.triggerAttackRelease(x,.12,n+i*.07)})},pippa:function(){['G4','E4','G4','C5','E5'].forEach(function(x,i){pluck.triggerAttack(x,n+i*.1)})},rosie:function(){['C4','E4','G4','B4','D5','G5'].forEach(function(x,i){bell.triggerAttackRelease([x],.12,n+i*.08)})}};(p[id]||p.luna)()}catch(e){}}
};

function toggleMusic(m){if(!A)return false;var t=Tone.getTransport();if(t.state==='started'){t.stop();t.cancel();return false}if(m==='reggaeton'){t.bpm.value=95;var bi=0,mi=0;var bn=['C2','C2','G2','G2'];t.scheduleRepeat(function(time){kick.triggerAttackRelease('C1','16n',time)},'4n');t.scheduleRepeat(function(time){kick.triggerAttackRelease('G1','16n',time)},{interval:'4n',offset:'4n + 8n'});t.scheduleRepeat(function(time){hat.triggerAttackRelease('32n',time)},'8n');t.scheduleRepeat(function(time){bass.triggerAttackRelease(bn[bi++%bn.length],'8n',time)},'2n');t.scheduleRepeat(function(time){pluck.triggerAttack(['G4','C5','E5'][mi++%3],time)},'4n');t.scheduleRepeat(function(time){bell.triggerAttackRelease(['C4','E4','G4'],'8n',time,.08)},'1n')}else{t.bpm.value=112;var bn2=['C2','C2','F2','F2','G2','G2','C2','C2'],mn=['C5','D5','E5','G5','A5','G5','E5','D5','C5','E5','G5','A5','G5','E5','D5','C5'],ch=[['C3','E3','G3'],['F3','A3','C4'],['G3','B3','D4'],['C3','E3','G3']];var b2=0,m2=0,c2=0;t.scheduleRepeat(function(time){kick.triggerAttackRelease('C1','8n',time)},'4n');t.scheduleRepeat(function(time){hat.triggerAttackRelease('32n',time)},'8n');t.scheduleRepeat(function(time){bass.triggerAttackRelease(bn2[b2++%bn2.length],'8n',time)},'4n');t.scheduleRepeat(function(time){xylo.triggerAttackRelease(mn[m2++%mn.length],'8n',time)},'8n');t.scheduleRepeat(function(time){pad.triggerAttackRelease(ch[c2++%ch.length],'2n',time,.1)},'1n')}t.start();return true}

var pk=function(a){return a[Math.floor(Math.random()*a.length)]};

/* ═══════════════════════════════════════════════════
   CHARACTER SVGS
   ═══════════════════════════════════════════════════ */
var CSV={
luna:function(s){return '<svg viewBox="0 0 200 200" width="'+s+'" height="'+s+'"><path d="M 40 160 Q 10 130 20 100 Q 25 80 40 90" fill="none" stroke="#B088F9" stroke-width="8" stroke-linecap="round"><animateTransform attributeName="transform" type="rotate" values="-8 40 160;8 40 160;-8 40 160" dur="1.5s" repeatCount="indefinite"/></path><ellipse cx="100" cy="150" rx="50" ry="35" fill="#B088F9"/><ellipse cx="100" cy="155" rx="35" ry="20" fill="#E0D0FF"/><circle cx="100" cy="95" r="42" fill="#B088F9"/><polygon points="65,65 55,28 82,55" fill="#B088F9"/><polygon points="135,65 145,28 118,55" fill="#B088F9"/><polygon points="68,62 60,36 80,55" fill="#FFB6C1"/><polygon points="132,62 140,36 120,55" fill="#FFB6C1"/><circle cx="100" cy="100" r="30" fill="#E0D0FF"/><ellipse cx="87" cy="88" rx="9" ry="10" fill="#333"/><ellipse cx="113" cy="88" rx="9" ry="10" fill="#333"/><circle cx="90" cy="85" r="3.5" fill="white"/><circle cx="116" cy="85" r="3.5" fill="white"/><ellipse cx="100" cy="98" rx="4" ry="3" fill="#FF8FAB"/><path d="M 90 104 Q 100 115 110 104" fill="none" stroke="#333" stroke-width="2.5" stroke-linecap="round"/><line x1="58" y1="95" x2="78" y2="98" stroke="#ddd" stroke-width="1.5"/><line x1="56" y1="103" x2="78" y2="102" stroke="#ddd" stroke-width="1.5"/><line x1="122" y1="98" x2="142" y2="95" stroke="#ddd" stroke-width="1.5"/><line x1="122" y1="102" x2="144" y2="103" stroke="#ddd" stroke-width="1.5"/><circle cx="70" cy="68" r="5" fill="#FF6B9D"/><ellipse cx="60" cy="65" rx="9" ry="5.5" fill="#FF6B9D" transform="rotate(-20 60 65)"/><ellipse cx="78" cy="72" rx="9" ry="5.5" fill="#FF6B9D" transform="rotate(15 78 72)"/><ellipse cx="75" cy="178" rx="14" ry="8" fill="#B088F9"/><ellipse cx="125" cy="178" rx="14" ry="8" fill="#B088F9"/></svg>'},
